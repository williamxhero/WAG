GATEWAY_HOST=yosef-server
GATEWAY_BIND_HOST=127.0.0.1
# Healthcheck connects locally to this bind (wildcards map to loopback), while
# sending GATEWAY_HOST as the logical Host header. Override only if required:
# GATEWAY_HEALTHCHECK_HOST=127.0.0.1
GATEWAY_PORT=8930
GATEWAY_TOKEN=__GENERATED__
# Client authentication is required by default (unset or 0); only 1 permits
# anonymous access. In that mode GATEWAY_TOKEN is optional, but any supplied
# Authorization must still match it. Rate limits use the client socket address
# instead of the token. CRAWL4AI_TOKEN is unaffected. Set back to 0 and supply
# a token of at least 32 characters to restore required client authentication.
# GATEWAY_ALLOW_ANONYMOUS=0
SEARXNG_URL=http://yosef-server:8801
CRAWL4AI_URL=http://127.0.0.1:11235
# Complete streamed JSON response ceiling (80 MiB), before JSON parsing.
CRAWL4AI_RESPONSE_MAX_BYTES=83886080
CRAWL4AI_TOKEN=__GENERATED__
PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# Must match Playwright MCP --output-dir and stay outside ARTIFACT_DIR.
PLAYWRIGHT_OUTPUT_DIR=/data/web-access-gateway/data/playwright/output
EGRESS_PROXY=http://127.0.0.1:7895
ARTIFACT_DIR=/data/web-access-gateway/artifacts
ARTIFACT_BASE_URL=http://yosef-server:8930
ARTIFACT_MAX_BYTES=26214400
ARTIFACT_QUOTA_BYTES=1073741824
GATEWAY_REQUEST_CONCURRENCY=16
GATEWAY_HOST_CONCURRENCY=4
GATEWAY_TOKEN_RATE_LIMIT=120
GATEWAY_TOKEN_RATE_WINDOW_MS=60000
GATEWAY_ALLOWED_HOSTS=yosef-server,localhost,127.0.0.1,[::1]
