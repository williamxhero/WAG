[Unit]
Description=Web Access Gateway - Playwright MCP
After=network-online.target web-access-egress-proxy.service
Wants=network-online.target web-access-egress-proxy.service

[Service]
Type=simple
User=yosef
Group=yosef
WorkingDirectory=/data/web-access-gateway/runtime/playwright-mcp
EnvironmentFile=/data/web-access-gateway/config/playwright.env
Environment=HOME=/data/web-access-gateway/data/playwright
Environment=XDG_CACHE_HOME=/data/web-access-gateway/data/playwright/cache
Environment=XDG_CONFIG_HOME=/data/web-access-gateway/data/playwright/config
Environment=PATH=/data/web-access-gateway/runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Prepare the shared Playwright staging tree before starting. It lives outside
# ARTIFACT_DIR and is shared with web-access-gateway.service. A prior run or
# operator can leave these paths owned by root; an unprivileged "mkdir -p" as
# User=yosef then fails with EACCES and the unit restarts forever (observed
# 2026-10-07). ProtectSystem=full never covers /data, so that failure was POSIX
# ownership, not a read-only mount: ReadWritePaths only affects the mount
# namespace. The "+" prefix runs these lines with full privileges so the tree is
# always created and owned by the service identity; a genuine failure still
# aborts startup instead of being masked.
ExecStartPre=+/usr/bin/mkdir -p /data/web-access-gateway/data/playwright/output /data/web-access-gateway/data/playwright/config /data/web-access-gateway/data/playwright/cache
ExecStartPre=+/usr/bin/chown yosef:yosef /data/web-access-gateway/data/playwright /data/web-access-gateway/data/playwright/output /data/web-access-gateway/data/playwright/config /data/web-access-gateway/data/playwright/cache
ExecStartPre=+/usr/bin/chmod 0750 /data/web-access-gateway/data/playwright /data/web-access-gateway/data/playwright/output /data/web-access-gateway/data/playwright/config /data/web-access-gateway/data/playwright/cache
ExecStart=/data/web-access-gateway/runtime/playwright-mcp/node_modules/.bin/playwright-mcp --host 127.0.0.1 --port 8931 --headless --executable-path /data/web-access-gateway/runtime/playwright-browsers/chromium-1237/chrome-linux64/chrome --isolated --block-service-workers --output-dir /data/web-access-gateway/data/playwright/output --output-max-size 1073741824 --timeout-action 5000 --timeout-navigation 60000 --timeout-settle 500 --proxy-server http://127.0.0.1:7895
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
MemoryMax=6G
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/data/web-access-gateway/runtime /data/web-access-gateway/data

[Install]
WantedBy=multi-user.target
